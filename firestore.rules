rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// DinoDesign Firestore security rules
//
// Authorization model
//   • A "user" is a Firebase Auth uid. Studio (web) signs the user in
//     directly; the Figma plugin signs in via a one-time custom token
//     produced by the device-pairing flow (see functions/pluginPairing.js).
//     After pairing, the plugin holds a regular Firebase Auth session bound
//     to the same uid as the studio session that approved the pairing.
//   • A document in `designSystems` is owned by the uid stored in its
//     `userId` field. Owners may read and write that document; nobody else
//     can touch it.
//   • `pairingCodes` are created and consumed exclusively via cloud
//     functions running with the Admin SDK (which bypasses these rules).
//     Clients never read or write that collection directly.
//   • `payments` are written by the Stripe webhook (Admin SDK) and read by
//     the owning user only.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // designSystems/{id}
    //   userId field is the owner's uid. We verify owner-ness on every op
    //   and prevent userId from being rewritten on update (otherwise an
    //   owner could silently transfer their record to someone else).
    match /designSystems/{id} {
      allow read:   if isOwner(resource.data.userId);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);

      // Tamper-resistant event log: owner can read, create, and delete
      // entries (deletion is needed so deleting a design system can also
      // clear its audit trail — orphaned events otherwise sit forever and
      // leak user data). Updates are still blocked so individual events
      // can't be rewritten after the fact.
      match /events/{eid} {
        allow read, create, delete: if isOwner(
          get(/databases/$(database)/documents/designSystems/$(id)).data.userId
        );
        allow update: if false;
      }

      // Version snapshots — owner-only read/write/delete. Each doc is the
      // full snapshot needed to regenerate this version's CSS/tokens on
      // demand (Phase 2 will add a Cloud Function that materializes them).
      // Updates are blocked: a "version" is immutable by definition; re-
      // exports always write a new doc, never modify an existing one.
      match /versions/{vid} {
        allow read, create, delete: if isOwner(
          get(/databases/$(database)/documents/designSystems/$(id)).data.userId
        );
        allow update: if false;
      }

      // Add-on entitlements — which add-ons this design system has been
      // granted access to. Readable by the design system's owner OR an admin.
      // Writes (grants, revokes, version pins) are admin-only — customers
      // never grant themselves entitlements; grants come from the studio UI,
      // Stripe webhooks, or manual admin actions in the Firebase console.
      match /entitlements/{addOnId} {
        allow read:  if isAdmin()
                     || isOwner(get(/databases/$(database)/documents/designSystems/$(id)).data.userId);
        allow write: if isAdmin();
      }
    }

    // payments/{id}
    //   Owner-readable; written exclusively by the Stripe webhook function.
    match /payments/{pid} {
      allow read:  if isOwner(resource.data.userId);
      allow write: if false;
    }

    // users/{uid}
    //   Owner-readable; written by webhook (credit increments) only.
    match /users/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // pairingCodes/{code}
    //   Strictly cloud-function-only. The plugin and studio talk to the
    //   functions; nobody touches Firestore directly here.
    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    // componentProposals/{id}
    //   Submitted by lib consumers via the submitComponentProposal cloud
    //   function (Admin SDK, bypasses rules). Admin users read + update
    //   status from the /admin/proposals dashboard. Nobody can write
    //   directly; that would let anyone bypass rate limiting and validation.
    //
    //   Admin status is tracked on users/{uid}.isAdmin. Flip that field to
    //   true on your own user doc via the Firebase console to grant access.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /componentProposals/{pid} {
      allow read:   if isAdmin();
      // Admin can change status / add review notes, but the original
      // submitted fields must stay intact — we only check that the fields
      // an admin should be touching are the ones being touched.
      allow update: if isAdmin()
                    && request.resource.data.componentName == resource.data.componentName
                    && request.resource.data.implementation == resource.data.implementation
                    && request.resource.data.proposedApi == resource.data.proposedApi;
      allow create, delete: if false;
    }

    // addOns/{addOnId}
    //   Catalog of available add-ons, written exclusively by admins via the
    //   publishAddOn cloud function. Any signed-in user can read catalog
    //   metadata (so the customer plugin can show display names/versions
    //   without a cloud-function round-trip for trivial data). The actual
    //   spec JSON lives in Storage, not Firestore — see storage.rules.
    match /addOns/{addOnId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();

      // Version history. Each doc records the storage path, publishedBy,
      // publishedAt, notes, sizeBytes for a single version. Versions are
      // immutable in practice; we don't enforce that here because publish
      // always writes a fresh version doc rather than mutating one.
      match /versions/{version} {
        allow read:  if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // rateLimits/{key}
    //   Cloud-function-only counter docs (one per IP per protected endpoint).
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // text-gate-feedback/{id}
    //   Labeled training data for the typography matcher's text-vs-non-text
    //   gate. Any signed-in user can create entries (their matcher runs
    //   contribute to the corpus). Each entry must carry the writer's uid
    //   so we can attribute and audit. No reads or updates from clients —
    //   training pulls go through a Cloud Function / admin SDK.
    match /text-gate-feedback/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // figma-conversion-feedback/{id}
    //   Internal AAID workbench feedback. The same signed-in user who
    //   creates a conversion record can patch it later with verdict +
    //   correction (so we can wire the "save feedback" button after the
    //   "Convert" call). Admin-only in practice — page is gated by
    //   users/{uid}.isAdmin === true at the UI layer. Reads only via
    //   Cloud Function / admin SDK for fine-tuning pulls.
    match /figma-conversion-feedback/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow read, delete: if false;
    }
  }
}
